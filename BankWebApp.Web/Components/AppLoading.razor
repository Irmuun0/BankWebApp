<div class="app-loading" role="status" aria-live="polite">
    <div class="app-loading-spinner" aria-hidden="true"></div>
    <div>
        <strong>@DisplayTitle</strong>
        <span>@Message</span>
    </div>
</div>

@code {
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string Title { get; set; } = "Loading";

    [Parameter]
    public string Message { get; set; } = "Please wait while the system loads data.";

    private string DisplayTitle => string.IsNullOrWhiteSpace(Text) ? Title : Text;
}
