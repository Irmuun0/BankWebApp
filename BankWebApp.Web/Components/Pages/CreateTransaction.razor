@page "/transactions/create"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "USER,ADMIN")]
@using System.Globalization
@inject ICurrentUserService CurrentUser
@inject IAccountService AccountService
@inject ITransactionService TransactionService
@inject IExchangeRateService ExchangeRateService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Гүйлгээ хийх</PageTitle>

<h1>Гүйлгээ хийх</h1>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger" role="alert">@Error</div>
}

@if (showReceipt && receipt is not null)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="background: rgba(0,0,0,.35); z-index: 1050;"
         @onclick="DismissReceipt">
        <div class="bg-white border rounded p-4 shadow" style="width: min(460px, 92vw);" @onclick:stopPropagation>
            <h2 class="h5 mb-3">Гүйлгээ амжилттай боллоо</h2>

            <dl class="row mb-3">
                <dt class="col-sm-5">Шилжүүлсэн дүн</dt>
                <dd class="col-sm-7">@receipt.Amount.ToString("N2") @receipt.SourceCurrency</dd>

                <dt class="col-sm-5">Огноо цаг</dt>
                <dd class="col-sm-7">@receipt.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                <dt class="col-sm-5">Үлдсэн үлдэгдэл</dt>
                <dd class="col-sm-7">@receipt.SenderRemainingBalance.ToString("N2") @receipt.SourceCurrency</dd>

                <dt class="col-sm-5">Хүлээн авагч</dt>
                <dd class="col-sm-7">@receipt.ReceiverOwnerName</dd>

                <dt class="col-sm-5">Хүлээн авсан данс</dt>
                <dd class="col-sm-7">@receipt.ReceiverAccountNumber</dd>

                <dt class="col-sm-5">Гүйлгээний утга</dt>
                <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(receipt.Description) ? "-" : receipt.Description)</dd>
            </dl>

            <button class="btn btn-primary w-100" type="button" @onclick="CloseReceipt">Хаах</button>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Success))
{
    <div class="alert alert-success" role="alert">@Success</div>
}

@if (isLoading)
{
    <p><em>Уншиж байна...</em></p>
}
else if (!string.IsNullOrWhiteSpace(loadErrorMessage))
{
    <div class="alert alert-warning" role="alert">@loadErrorMessage</div>
}
else if (activeAccounts.Count == 0)
{
    <div class="alert alert-warning" role="alert">Гүйлгээ хийх идэвхтэй данс байхгүй байна.</div>
    <a class="btn btn-primary" href="/accounts/open">Данс нээх</a>
}
else
{
    <form method="post" action="/transactions/create/submit" class="border rounded p-4" style="max-width: 560px;">
        <div class="mb-3">
            <label class="form-label" for="fromAccountId">Илгээх данс</label>
            <select class="form-select" id="fromAccountId" name="FromAccountId" value="@SelectedFromAccountValue" @onchange="OnFromAccountChanged" required>
                @foreach (var account in activeAccounts)
                {
                    <option value="@account.Id">@FormatAccountOption(account)</option>
                }
            </select>
            @if (SelectedFromAccount is not null)
            {
                <div class="small text-muted mt-1">Үлдэгдэл: @SelectedFromAccount.Balance.ToString("N2") @SelectedFromAccount.Currency</div>
                <div class="small mt-1 @(IsTransferLimitExceeded ? "text-danger" : "text-muted")">
                    Өдрийн гүйлгээний лимит: @SelectedFromAccount.DailyTransactionLimitMnt.ToString("N2") MNT
                </div>
                @if (IsTransferLimitExceeded)
                {
                    <div class="small text-danger mt-1">Оруулсан дүн энэ дансны өдрийн лимитээс давсан байна.</div>
                }
            }
        </div>

        <div class="mb-3">
            @if (IsOwnTransfer)
            {
                <label class="form-label" for="toOwnAccountNumber">Хүлээн авах данс</label>
                <select class="form-select" id="toOwnAccountNumber" name="ToAccountNumber" value="@selectedToOwnAccountNumber" @onchange="OnOwnReceiverChanged" required>
                    @foreach (var account in ReceiverOwnAccounts)
                    {
                        <option value="@account.AccountNumber">@FormatAccountOption(account)</option>
                    }
                </select>
                @if (SelectedOwnReceiverAccount is not null)
                {
                    <div class="small text-muted mt-1">Үлдэгдэл: @SelectedOwnReceiverAccount.Balance.ToString("N2") @SelectedOwnReceiverAccount.Currency</div>
                }
                else
                {
                    <div class="small text-muted mt-1">Хүлээн авах өөр данс байхгүй байна.</div>
                }
            }
            else
            {
                <label class="form-label" for="toAccountNumber">Хүлээн авах дансны дугаар</label>
                <input class="form-control"
                       id="toAccountNumber"
                       name="ToAccountNumber"
                       value="@toAccountNumber"
                       @oninput="OnReceiverAccountInput"
                       inputmode="numeric"
                       pattern="[0-9]{10}"
                       minlength="10"
                       maxlength="10"
                       onbeforeinput="if (event.data !== null && !/^[0-9]+$/.test(event.data)) event.preventDefault();"
                       onpaste="if (!/^[0-9]+$/.test((event.clipboardData || window.clipboardData).getData('text'))) event.preventDefault();"
                       ondrop="event.preventDefault();"
                       autocomplete="off"
                       required />

                @if (hasInvalidReceiverAccountNumber)
                {
                    <div class="small text-danger mt-1">Дансны дугаарт зөвхөн 0-9 тоо оруулна уу.</div>
                }
                else if (!string.IsNullOrEmpty(toAccountNumber) && toAccountNumber.Length != 10)
                {
                    <div class="small text-danger mt-1">Хүлээн авах дансны дугаар 10 оронтой байна.</div>
                }

                @if (receiverPreview is not null)
                {
                    <table class="table table-sm table-bordered mt-2 mb-0">
                        <tbody>
                            <tr>
                                <th style="width: 180px;">Данс эзэмшигч</th>
                                <td>@receiverPreview.OwnerDisplayName</td>
                            </tr>
                            <tr>
                                <th>Валют</th>
                                <td>@receiverPreview.Currency</td>
                            </tr>
                        </tbody>
                    </table>
                }
                else if (!string.IsNullOrWhiteSpace(receiverPreviewMessage))
                {
                    <div class="small text-muted mt-2">@receiverPreviewMessage</div>
                }
            }
        </div>

        <div class="mb-3">
            <label class="form-label" for="amountWhole">Шилжүүлэх мөнгөн дүн</label>
            <div class="d-flex align-items-center gap-1">
                <input class="form-control"
                       style="max-width: 180px;"
                       id="amountWhole"
                       value="@amountWhole"
                       @oninput="OnAmountWholeInput"
                       inputmode="numeric"
                       pattern="[0-9]{1,16}"
                       maxlength="16"
                       onbeforeinput="if (event.data !== null && !/^[0-9]+$/.test(event.data)) event.preventDefault();"
                       onpaste="if (!/^[0-9]+$/.test((event.clipboardData || window.clipboardData).getData('text'))) event.preventDefault();"
                       ondrop="event.preventDefault();"
                       autocomplete="off"
                       placeholder="0"
                       required />
                <span class="px-1">.</span>
                <input class="form-control text-center"
                       style="max-width: 72px;"
                       value="@amountCents"
                       @oninput="OnAmountCentsInput"
                       inputmode="numeric"
                       pattern="[0-9]{1,2}"
                       onbeforeinput="if (event.data !== null && !/^[0-9]+$/.test(event.data)) event.preventDefault();"
                       onpaste="if (!/^[0-9]+$/.test((event.clipboardData || window.clipboardData).getData('text'))) event.preventDefault();"
                       ondrop="event.preventDefault();"
                       autocomplete="off"
                       maxlength="2"
                       required />
                <span class="badge text-bg-light border ms-2">@SelectedFromAccountCurrency</span>
            </div>
            <div class="form-text">Зөвхөн 0-9 цифр оруулна. Бутархай хэсэг хамгийн ихдээ 2 оронтой байна.</div>
            @if (HasInvalidAmountInput)
            {
                <div class="small text-danger mt-1">Мөнгөн дүнд зөвхөн тоо оруулна уу.</div>
            }
            <input type="hidden" name="Amount" value="@ComposedAmount" />
            <input type="hidden" name="TransferType" value="@TransferType" />
        </div>

        @if (exchangeRateQuote is not null)
        {
            <div class="alert alert-info py-2" role="status">
                <div class="fw-semibold">Хөрвүүлэх ханш</div>
                <div>@exchangeRateQuote.DisplayText</div>
                <div class="small text-muted">Эх сурвалж: Монголбанк, @exchangeRateQuote.RateDate.ToString("yyyy-MM-dd")</div>

                @if (EnteredAmount > 0)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <div class="border rounded bg-white p-2 h-100">
                                <div class="small text-muted">Гүйлгээний дүн</div>
                                <div class="fw-semibold">@EnteredAmount.ToString("N2") @exchangeRateQuote.FromCurrency</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded bg-white p-2 h-100">
                                <div class="small text-muted">Хүлээн авах дүн</div>
                                <div class="fw-semibold">@ConvertedReceiveAmount.ToString("N2") @exchangeRateQuote.ToCurrency</div>
                            </div>
                        </div>
                    </div>

                    @if (IsConvertedReceiveAmountTooSmall)
                    {
                        <div class="small text-danger mt-2">Хүлээн авах дүн 1-ээс их байх ёстой.</div>
                    }
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(exchangeRateMessage))
        {
            <div class="alert alert-warning py-2" role="alert">@exchangeRateMessage</div>
        }

        <div class="mb-3">
            <label class="form-label" for="description">Гүйлгээний утга</label>
            <textarea class="form-control"
                      id="description"
                      name="Description"
                      maxlength="500"
                      rows="3"
                      @bind="transactionDescription"
                      @bind:event="oninput"
                      required></textarea>
            @if (ShowDescriptionWarning)
            {
                <div class="small text-danger mt-1">Гүйлгээний утга оруулна уу.</div>
            }

            <div class="d-flex flex-wrap gap-1 mt-2">
                @foreach (var option in descriptionOptions)
                {
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => AddDescriptionOption(option)">
                        @option
                    </button>
                }
            </div>
        </div>

        <button class="btn btn-primary" type="submit" disabled="@(IsTransferLimitExceeded || HasInvalidAmountInput || HasInvalidReceiverAccountNumber)">Гүйлгээ хийх</button>
        <a class="btn btn-link" href="/transactions">Гүйлгээний түүх</a>
    </form>
}
