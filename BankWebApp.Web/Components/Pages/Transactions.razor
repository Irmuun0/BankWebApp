@page "/transactions"
@attribute [Authorize(Roles = "USER,ADMIN")]
@rendermode InteractiveServer
@inject ICurrentUserService CurrentUser
@inject IAccountService AccountService
@inject ITransactionService TransactionService
@inject NavigationManager Navigation

<PageTitle>Гүйлгээний түүх</PageTitle>

<section class="transactions-page">
    @if (isLoading)
    {
        <div class="transactions-state">Уншиж байна...</div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning" role="alert">@errorMessage</div>
    }
    else
    {
        <form class="transactions-filter-card" method="get" action="/transactions">
            <div class="filter-main">
                <div class="filter-field filter-account">
                    <label class="form-label" for="accountId">Данс</label>
                    <select class="form-select" id="accountId" name="accountId">
                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id" selected="@(account.Id == selectedAccountId)">
                                @account.AccountNumber - @DisplayAccountType(account.AccountType)/@account.Currency (@account.Balance.ToString("N2"))
                            </option>
                        }
                    </select>
                </div>

                <div class="filter-field">
                    <label class="form-label" for="startDate">Эхлэх огноо</label>
                    <input class="form-control" id="startDate" type="date" name="startDate" value="@filterStartDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-field">
                    <label class="form-label" for="endDate">Дуусах огноо</label>
                    <input class="form-control" id="endDate" type="date" name="endDate" value="@filterEndDate.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-submit">
                    <button class="btn btn-primary" type="submit">Харах</button>
                </div>
            </div>

            <div class="filter-presets" aria-label="Хурдан хугацааны сонголт">
                <span class="filter-presets-label">Хурдан сонголт</span>
                <a class="btn btn-outline-secondary" href="@BuildPresetHref("today")">Өнөөдөр</a>
                <a class="btn btn-outline-secondary" href="@BuildPresetHref("last2")">Өнөөдөр + өчигдөр</a>
                <a class="btn btn-outline-secondary" href="@BuildPresetHref("last7")">7 хоног</a>
                <a class="btn btn-outline-secondary" href="@BuildPresetHref("last30")">30 хоног</a>
            </div>
        </form>

        @if (transactions.Count == 0)
        {
            <div class="transactions-state">
                <strong>Гүйлгээ олдсонгүй.</strong>
                <span>Данс эсвэл хугацаагаа өөрчлөөд дахин шалгана уу.</span>
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-4">
                    <DonutChart Title="Гүйлгээний чиглэл"
                                Subtitle="Сонгосон дансны орлого, зарлага"
                                Unit="ш"
                                Items="@TransactionDirectionChart" />
                </div>
                <div class="col-12 col-lg-4">
                    <DonutChart Title="Гүйлгээний төлөв"
                                Subtitle="Амжилттай болон бусад төлөв"
                                Unit="ш"
                                Items="@TransactionStatusChart" />
                </div>
                <div class="col-12 col-lg-4">
                    <BarChart Title="Орлого, зарлагын бүтэц"
                              Subtitle="Валют болон чиглэлээр нэгтгэсэн дүн"
                              Items="@CashflowByCurrencyChart" />
                </div>
                <div class="col-12">
                    <LineChart Title="Өдрийн идэвх"
                               Subtitle="Сонгосон хугацааны өдөр бүрийн гүйлгээний тоо"
                               Unit="ш"
                               Items="@TransactionTrendChart" />
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover transactions-table">
                    <thead>
                        <tr>
                            <th>Цаг</th>
                            <th>Чиглэл</th>
                            <th>Илгээгч</th>
                            <th>Хүлээн авагч</th>
                            <th>Дүн</th>
                            <th>Орсон дүн</th>
                            <th>Төлөв</th>
                            <th>Гүйлгээний утга</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in transactions.GroupBy(transaction => DateOnly.FromDateTime(transaction.CreatedAt)).OrderByDescending(group => group.Key))
                        {
                            <tr class="transaction-date-group">
                                <td colspan="8">@group.Key.ToString("yyyy.MM.dd")</td>
                            </tr>

                            @foreach (var transaction in group)
                            {
                                <tr role="button" onclick="window.location.href='@BuildDetailHref(transaction.Id)'">
                                    <td class="transaction-time-cell">@transaction.CreatedAt.ToString("HH:mm")</td>
                                    <td>@DisplayDirection(transaction.Direction)</td>
                                    <td>@transaction.FromAccountNumber</td>
                                    <td>@transaction.ToAccountNumber</td>
                                    <td class="money-stack">
                                        <span class="money-amount">@transaction.Amount.ToString("N2")</span>
                                        <span class="money-currency">@transaction.SourceCurrency</span>
                                    </td>
                                    <td class="money-stack">
                                        <span class="money-amount">@transaction.CreditedAmount.ToString("N2")</span>
                                        <span class="money-currency">@transaction.TargetCurrency</span>
                                    </td>
                                    <td>@DisplayStatus(transaction.Status)</td>
                                    <td class="transaction-description">@transaction.Description</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

<TransactionDetailModal Receipt="@selectedReceipt"
                        CloseHref="@BuildCloseHref()"
                        OnClose="@CloseTransactionDetailAsync" />
