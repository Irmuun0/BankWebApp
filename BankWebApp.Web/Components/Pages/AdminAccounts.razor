@page "/admin/accounts"
@attribute [Authorize(Roles = "ADMIN")]
@inject IAdminService AdminService
@inject NavigationManager Navigation

<PageTitle>Админ - Данснууд</PageTitle>

@if (!string.IsNullOrWhiteSpace(Success))
{
    <div class="alert alert-success" role="alert">@Success</div>
}

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger" role="alert">@Error</div>
}

<section class="admin-filter-card">
    <form method="get" action="/admin/accounts">
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <label class="form-label">Ерөнхий хайлт</label>
                <input class="form-control" name="search" value="@Search" placeholder="Данс, эзэмшигч, валют хайх" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Username</label>
                <input class="form-control" name="username" value="@Username" placeholder="bat" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Данс</label>
                <input class="form-control" name="accountNumber" value="@AccountNumber" placeholder="1000..." />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Валют</label>
                <select class="form-select" name="currency">
                    <option value="">Бүгд</option>
                    <option value="MNT" selected="@(Currency == "MNT")">MNT</option>
                    <option value="USD" selected="@(Currency == "USD")">USD</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Төлөв</label>
                <select class="form-select" name="status">
                    <option value="">Бүгд</option>
                    <option value="ACTIVE" selected="@(Status == "ACTIVE")">Идэвхтэй</option>
                    <option value="INACTIVE" selected="@(Status == "INACTIVE")">Идэвхгүй</option>
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Доод үлдэгдэл</label>
                <input class="form-control" type="number" step="0.01" name="minBalance" value="@FormatDecimal(MinBalance)" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Дээд үлдэгдэл</label>
                <input class="form-control" type="number" step="0.01" name="maxBalance" value="@FormatDecimal(MaxBalance)" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Нээсэн эхлэх</label>
                <input class="form-control" type="date" name="createdFrom" value="@FormatDateInput(CreatedFrom)" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Нээсэн дуусах</label>
                <input class="form-control" type="date" name="createdTo" value="@FormatDateInput(CreatedTo)" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">Мөр</label>
                <select class="form-select" name="pageSize">
                    <option value="20" selected="@(PageSize == 20)">20</option>
                    <option value="50" selected="@(PageSize == 50)">50</option>
                    <option value="100" selected="@(PageSize == 100)">100</option>
                </select>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button class="btn btn-primary" type="submit">Шүүх</button>
            <a class="btn btn-outline-secondary" href="/admin/accounts">Цэвэрлэх</a>
        </div>
    </form>
</section>

@if (isLoading)
{
    <AppLoading Text="Дансны мэдээлэл уншиж байна..." />
}
else if (accounts.Items.Count == 0)
{
    <div class="empty-state">Шүүлтэд тохирох данс олдсонгүй.</div>
}
else
{
    <div class="table-responsive admin-table-shell">
        <table class="table table-striped align-middle" data-client-sort="true">
            <thead>
                <tr>
                    <th>Эзэмшигч</th>
                    <th>Дансны дугаар</th>
                    <th>Төрөл</th>
                    <th>Валют</th>
                    <th>Үлдэгдэл</th>
                    <th>Өдрийн лимит</th>
                    <th>Төлөв</th>
                    <th>Нээсэн огноо</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in accounts.Items)
                {
                    <tr>
                        <td>
                            <div>@account.Username</div>
                            <div class="small text-muted">@(account.FullName ?? "-")</div>
                        </td>
                        <td class="numeric-cell">@account.AccountNumber</td>
                        <td>@DisplayAccountType(account.AccountType)</td>
                        <td>@account.Currency</td>
                        <td class="money-stack">
                            <span class="money-amount">@account.Balance.ToString("N2")</span>
                            <span class="money-currency">@account.Currency</span>
                        </td>
                        <td class="money-stack">
                            <span class="money-amount">@account.DailyTransactionLimitMnt.ToString("N2")</span>
                            <span class="money-currency">MNT</span>
                        </td>
                        <td>@(account.IsAdminLocked ? "Админаар хаасан" : DisplayActive(account.IsActive))</td>
                        <td>@account.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2 align-items-center">
                                <a class="btn btn-sm btn-outline-primary" href="@BuildLimitModalUrl(account.Id)">Лимит тохируулах</a>
                                <form method="post" action="/admin/accounts/toggle-status">
                                    <input type="hidden" name="AccountId" value="@account.Id" />
                                    <input type="hidden" name="IsActive" value="@(account.IsActive ? "false" : "true")" />
                                    <input type="hidden" name="ReturnUrl" value="@CurrentPageUrl" />
                                    <button class="btn p-0 border-0 bg-transparent" type="submit" title="Төлөв солих">
                                        <span class="d-inline-flex align-items-center rounded-pill p-1 @(account.IsActive ? "bg-success" : "bg-secondary")" style="width: 44px;">
                                            <span class="bg-white rounded-circle d-inline-block @(account.IsActive ? "ms-auto" : "")" style="width: 18px; height: 18px;"></span>
                                        </span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <AdminPager BasePath="/admin/accounts" Page="@accounts.Page" TotalPages="@accounts.TotalPages" Query="@BuildPagerQuery()" />
}

@if (limitDetails is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5 mb-0">Өдрийн гүйлгээний лимит тохируулах</h2>
                        <div class="text-muted small">@limitDetails.AccountNumber · @limitDetails.Currency · @(limitDetails.OwnerName ?? "-")</div>
                    </div>
                    <a class="btn-close" href="@CloseLimitModalUrl" aria-label="Хаах"></a>
                </div>
                <form method="post" action="/admin/accounts/transaction-limit">
                    <div class="modal-body">
                        <input type="hidden" name="AccountId" value="@limitDetails.AccountId" />
                        <input type="hidden" name="ReturnUrl" value="@CurrentPageUrl" />
                        <div class="alert alert-light border">
                            Одоогийн өдрийн лимит: <strong>@limitDetails.CurrentDailyLimitMnt.ToString("N2") MNT</strong>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="limitAmount">Өдрийн нийт гарах гүйлгээний лимит</label>
                                <div class="input-group">
                                    <input class="form-control" id="limitAmount" name="LimitAmount" type="number" min="0.01" step="0.01" value="@FormatLimitValue(limitDetails.CurrentDailyLimitMnt)" />
                                    <span class="input-group-text">MNT</span>
                                </div>
                                <div class="form-text">Тухайн данснаас нэг өдөрт гарах нийт MNT equivalent дүн.</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="limitReason">Тайлбар</label>
                                <textarea class="form-control" id="limitReason" name="Reason" rows="3" maxlength="500"></textarea>
                            </div>
                        </div>
                        <hr />
                        <h3 class="h6">Өмнөх тохиргооны түүх</h3>
                        @if (limitDetails.Histories.Count == 0)
                        {
                            <p class="text-muted mb-0">Одоогоор лимит өөрчилсөн түүх байхгүй.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Огноо</th>
                                            <th>Өмнөх</th>
                                            <th>Шинэ</th>
                                            <th>Админ</th>
                                            <th>Тайлбар</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var history in limitDetails.Histories)
                                        {
                                            <tr>
                                                <td>@history.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@FormatHistoryLimit(history.OldLimitAmount)</td>
                                                <td>@FormatHistoryLimit(history.NewLimitAmount)</td>
                                                <td>@(history.ChangedByUsername ?? "-")</td>
                                                <td>@(string.IsNullOrWhiteSpace(history.Reason) ? "-" : history.Reason)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-outline-secondary" href="@CloseLimitModalUrl">Болих</a>
                        <button class="btn btn-primary" type="submit">Хадгалах</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
